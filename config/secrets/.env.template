# ─────────────────────────────────────────────────────────────────────────────
# PAOS — Secrets Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to config/secrets/.env and fill in your keys.
# NEVER commit config/secrets/.env — it is gitignored.
#
# Usage:
#   cp config/secrets/.env.template config/secrets/.env
#   nano config/secrets/.env
#
# Source in shell:
#   source config/secrets/.env
#
# Used automatically by:
#   bin/agent-commit.sh
#   docker/docker-compose.yaml
# ─────────────────────────────────────────────────────────────────────────────

# ── OpenAI (Codex) ────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Anthropic (Claude Code — API mode) ───────────────────────────────────────
# Get from: https://console.anthropic.com/settings/keys
# Note: Claude Code CLI uses OAuth by default; only needed for direct API use
ANTHROPIC_API_KEY=sk-ant-...

# ── Google / Gemini (Antigravity) ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Note: Antigravity uses OAuth login; only needed for direct Gemini API access
GOOGLE_API_KEY=AIza...

# ── PAOS Hub paths ───────────────────────────────────────────────────────────
# The install script (setup.sh / install-ubuntu.sh) patches these automatically.
# If installing manually, replace /home/YOUR_USER with your actual home path.
MEMORY_DIR=/home/YOUR_USER/AI_Workflow/memory
KNOWLEDGE_DIR=/home/YOUR_USER/AI_Workflow/knowledge
TEMPLATES_DIR=/home/YOUR_USER/AI_Workflow/knowledge/templates
LOGS_DIR=/home/YOUR_USER/AI_Workflow/logs

# ── System (sudo) ──────────────────────────────────────────────────────────────
# Used by install scripts and system-level operations
# WARNING: Store securely — grants root access
SUDO_PASSWORD=your_sudo_password_here
