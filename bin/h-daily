#!/usr/bin/env bash
# h-daily — Read or create today's daily note
# Usage: h-daily [date]

source "$(dirname "$0")/lib/h-common.sh"

DATE="${1:-$(date -u '+%Y-%m-%d')}"
DAILY_DIR="$PAOS_HOME/vault/daily"
DAILY_FILE="$DAILY_DIR/$DATE.md"

mkdir -p "$DAILY_DIR"

if [[ -f "$DAILY_FILE" ]]; then
  echo -e "${H_BOLD}Daily Note — $DATE${H_RESET}"
  echo ""
  cat "$DAILY_FILE"
else
  cat > "$DAILY_FILE" <<- NOTE
# Daily — $DATE

## Tasks

-

## Notes

-

## Decisions

-

---
Created: $(ts)
NOTE
  echo -e "${H_OK}Created daily note: ${DAILY_FILE/#$HOME/~}${H_RESET}"
  echo ""
  cat "$DAILY_FILE"
fi
