{
  "plugin": [
    "/home/dev/AI_Workflow/skills/ponytail-repo/.opencode/plugins/ponytail.mjs"
  ],
  "$schema": "https://opencode.ai/config.json",
  "model": "omniroute/auto/best-coding",
  "small_model": "omniroute/auto/best-fast",
  "default_agent": "build",
  "instructions": [
    ".opencode/workflow.md",
    ".opencode/user.md",
    "memory/shared/HANDOFF.md",
    "vault/chats/active_chat_transcript.md"
  ],
  "agent": {
    "build": {
      "mode": "all",
      "temperature": 0.3
    }
  },
  "mcp": {
    "shared-memory": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/home/dev/AI_Workflow/mcp/shared-memory-server/index.js"
      ],
      "environment": {
        "MEMORY_DIR": "/home/dev/AI_Workflow/memory",
        "KNOWLEDGE_DIR": "/home/dev/AI_Workflow/knowledge",
        "REPO_ROOT": "/home/dev/AI_Workflow"
      }
    },
    "scaffold": {
      "type": "local",
      "enabled": true,
      "command": [
        "node",
        "/home/dev/AI_Workflow/mcp/scaffold-server/index.js"
      ],
      "environment": {
        "TEMPLATES_DIR": "/home/dev/AI_Workflow/knowledge/templates"
      }
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-d67b84ab-9990-4b5b-b701-4734c64bfa75"
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "skill": {
      "*": "allow",
      "system-analysis-and-design": "allow",
      "project-scaffolder": "allow",
      "antigravity-review-loop": "allow",
      "skill-creator-elicitation": "allow"
    }
  },
  "provider": {
    "omniroute": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OmniRoute",
      "options": {
        "baseURL": "http://localhost:20128/v1",
        "apiKey": "omniroute",
        "headers": {
          "x-api-key": "omniroute"
        }
      },
      "models": {
        "auto/best-coding": {
          "name": "Auto Best Coding"
        },
        "auto/best-reasoning": {
          "name": "Auto Best Reasoning"
        },
        "auto/best-fast": {
          "name": "Auto Best Fast"
        },
        "auto/best-vision": {
          "name": "Auto Best Vision"
        },
        "auto/best-chat": {
          "name": "Auto Best Chat"
        },
        "auto/pro-coding": {
          "name": "Auto Pro Coding"
        },
        "auto/fast": {
          "name": "Auto Fast"
        },
        "auto/cheap": {
          "name": "Auto Cheap"
        },
        "auto/smart": {
          "name": "Auto Smart"
        },
        "auto/offline": {
          "name": "Auto Offline"
        },
        "auto/best-free": {
          "name": "Auto Best Free"
        },
        "auto/claude-opus": {
          "name": "Auto Claude Opus"
        },
        "auto/claude-sonnet": {
          "name": "Auto Claude Sonnet"
        }
      }
    }
  }
}