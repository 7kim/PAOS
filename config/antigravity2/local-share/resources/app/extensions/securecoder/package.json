{"name":"securecoder","displayName":"SecureCoder","description":"AI-powered vulnerability remediation for Antigravity","version":"0.0.1","publisher":"Google","engines":{"vscode":"^1.85.0"},"activationEvents":["*"],"main":"./out/extension.js","dependencies":{"minimatch":"^9.0.3"},"devDependencies":{"@types/mocha":"^10.0.10","@types/node":"^18.0.0","@types/vscode":"^1.85.0","@vscode/codicons":"^0.0.35","@vscode/test-electron":"^2.5.2","@vscode/vsce":"^2.22.0","esbuild":"^0.24.0","glob":"^13.0.1","mocha":"^11.7.5","ts-node":"^10.9.2","typescript":"^5.9.3"},"scripts":{"prettier-check":"prettier --check .","prettier-fix":"prettier --write .","compile":"tsc -p tsconfig.vsix.json","bundle":"esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js --minify --define:IS_PACKED=false","package":"vsce package --no-dependencies"},"contributes":{"viewsContainers":{"activitybar":[{"id":"securecoder-sidebar","title":"SecureCoder","icon":"static/shield.svg"}]},"views":{"securecoder-sidebar":[{"type":"webview","id":"securecoder-dashboard-view","name":"Find and Fix Issues","when":"securecoder.enabled"}]},"antigravityPlugins":[{"name":"securecoder","path":"./plugins/securecoder","description":"SecureCoder agent for security analysis and code remediation."}],"notebooks":[{"type":"securecoder-notebook","displayName":"SecureCoder Agent Session","selector":[{"filenamePattern":"*.securecoder"}]}],"commands":[{"command":"securecoder.enable","title":"SecureCoder: Enable","icon":"static/shield.svg"},{"command":"securecoder.disable","title":"SecureCoder: Disable"},{"command":"securecoder.ignore","title":"Ignore Vulnerability"},{"command":"securecoder.sendToAgent","title":"Ask Agent"},{"command":"securecoder.fixAllWithAgent","title":"Fix All Vulnerabilities with Agent"},{"command":"securecoder.showVulnDetail","title":"Show Vulnerability Details"},{"command":"securecoder.showIgnored","title":"Show Ignored Vulnerabilities"},{"command":"securecoder.clearAllIgnored","title":"Clear All Ignored Vulnerabilities"},{"command":"securecoder.rescan","title":"SecureCoder: Re-scan Last Scan Target","icon":"$(refresh)"},{"command":"securecoder.rescanFile","title":"Re-scan Active File","icon":"$(refresh)"},{"command":"securecoder.rescanDirectory","title":"Re-scan Directory","icon":"$(refresh)"},{"command":"securecoder.rescanSelection","title":"Re-scan Selection","icon":"$(refresh)"},{"command":"securecoder.showOnboarding","title":"SecureCoder: Show Onboarding"},{"command":"securecoder.selectScanner","title":"SecureCoder: Change Scanner"},{"command":"securecoder.scope.all","title":"⠀ All Files"},{"command":"securecoder.scope.active","title":"⠀ Active File"},{"command":"securecoder.wizAuthMenu","title":"SecureCoder: Wiz Authentication"},{"command":"securecoder.wizReauth","title":"SecureCoder: Re-authenticate Wiz"},{"command":"securecoder.wizLogout","title":"SecureCoder: Logout from Wiz"},{"command":"securecoder.scanDirectory","title":"SecureCoder: Scan Directory"},{"command":"securecoder.scanFile","title":"SecureCoder: Scan File"},{"command":"securecoder.customScan","title":"SecureCoder: Scan Specific Files/Folders...","icon":"$(folder-opened)"},{"command":"securecoder.editIgnoreFile","title":"SecureCoder: Edit SecureCoder Ignore File","icon":"$(settings-gear)"},{"command":"securecoder.clearFindings","title":"Clear Findings","icon":"$(trash)"},{"command":"securecoder.selectRuleSet","title":"SecureCoder: Select Scanner Mode"}],"submenus":[{"id":"securecoder.scope","label":"Scope","icon":"$(files)"}],"menus":{"view/title":[{"command":"securecoder.clearFindings","group":"navigation@1","when":"view == securecoder-dashboard-view"},{"command":"securecoder.rescanFile","group":"navigation@2","when":"view == securecoder-dashboard-view && securecoder.lastScanScopeType == 'file'"},{"command":"securecoder.rescanDirectory","group":"navigation@2","when":"view == securecoder-dashboard-view && securecoder.lastScanScopeType == 'directory'"},{"command":"securecoder.rescanSelection","group":"navigation@2","when":"view == securecoder-dashboard-view && securecoder.lastScanScopeType == 'selection'"}],"securecoder.scope":[{"command":"securecoder.scope.all","group":"scope@1","when":"securecoder.scope == activeFile"},{"command":"securecoder.scope.active","group":"scope@2","when":"securecoder.scope != activeFile"}],"explorer/context":[{"command":"securecoder.scanDirectory","group":"securecoder@1","when":"securecoder.enabled && explorerResourceIsFolder"},{"command":"securecoder.scanFile","group":"securecoder@1","when":"securecoder.enabled && !explorerResourceIsFolder"}]},"configuration":{"title":"SecureCoder","properties":{"securecoder.autostartFixes":{"type":"boolean","default":true,"description":"Automatically start executing fixes when sent to the agent."},"securecoder.debug":{"type":"boolean","default":false,"scope":"application","description":"Enable verbose debug logging for SecureCoder. Logs will be output to the SecureCoder output channel."},"securecoder.enabled":{"type":"boolean","default":false,"scope":"application","description":"Enable SecureCoder security scanning. When false, the extension is fully dormant. Toggle via the Command Palette: 'SecureCoder: Enable' or 'SecureCoder: Disable'."},"securecoder.ignoreMode":{"type":"string","enum":["workspace","comment"],"default":"workspace","description":"How vulnerabilities are ignored: 'workspace' (transient) or 'comment' (source modification)."},"securecoder.scannerBackend":{"type":"string","enum":["wiz","semgrep"],"default":"semgrep","description":"Which scanner to use. If not set, an onboarding page will prompt you to choose."},"securecoder.ruleSet":{"type":"string","enum":["fast","all"],"default":"fast","scope":"application","description":"Scan depth for the built-in scanner. 'fast' (Quick) runs intra-file checks only; 'all' (Deep) runs a comprehensive inter-file analysis (slower)."}}}}}