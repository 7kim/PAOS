projectManager.listSVNProjects#sideBarSVN","when":"view == projectsExplorerSVN","group":"navigation@10"},{"command":"projectManager.refreshSVNProjects","when":"view == projectsExplorerSVN","group":"navigation@11"},{"command":"projectManager.openSettings#sideBarSVN","when":"view == projectsExplorerSVN","group":"2_projectManager"},{"command":"projectManager.listAnyProjects#sideBarAny","when":"view == projectsExplorerAny","group":"navigation@10"},{"command":"projectManager.refreshAnyProjects","when":"view == projectsExplorerAny","group":"navigation@11"},{"command":"projectManager.openSettings#sideBarAny","when":"view == projectsExplorerAny","group":"2_projectManager"},{"command":"projectManager.listMercurialProjects#sideBarMercurial","when":"view == projectsExplorerMercurial","group":"navigation@10"},{"command":"projectManager.refreshMercurialProjects","when":"view == projectsExplorerMercurial","group":"navigation@11"},{"command":"projectManager.openSettings#sideBarMercurial","when":"view == projectsExplorerMercurial","group":"2_projectManager"}],"view/item/context":[{"command":"_projectManager.openInNewWindow","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind","group":"inline"},{"command":"_projectManager.open","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind","group":"navigation"},{"command":"_projectManager.openInNewWindow","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind","group":"navigation"},{"command":"_projectManager.revealInFinder#sideBar","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isMac","group":"navigation@2"},{"command":"_projectManager.revealInExplorer#sideBar","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isWindows","group":"navigation@2"},{"command":"_projectManager.revealInFileManager#sideBar","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind && isLinux","group":"navigation@2"},{"command":"_projectManager.deleteProject","when":"view == projectsExplorerFavorites && viewItem == ProjectNodeKind","group":"favorites"},{"command":"_projectManager.renameProject","when":"view == projectsExplorerFavorites && viewItem == ProjectNodeKind","group":"favorites"},{"command":"_projectManager.editTags","when":"view == projectsExplorerFavorites && viewItem == ProjectNodeKind","group":"favorites"},{"command":"_projectManager.toggleProjectEnabled","when":"view == projectsExplorerFavorites && viewItem == ProjectNodeKind","group":"favorites"},{"command":"projectManager.addToWorkspace#sideBar","when":"view =~ /projectsExplorer(Favorites|VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind","group":"workspace"},{"command":"projectManager.addToFavorites","when":"view =~ /projectsExplorer(VSCode|Git|SVN|Any|Mercurial)/ && viewItem == ProjectNodeKind","group":"workspace"}],"extension/context":[{"command":"_projectManager.whatsNewContextMenu","group":"projectManager","when":"extension == alefragnani.project-manager && extensionStatus == installed"}],"projectManager.sideBar.favorites.title":[{"command":"_projectManager.viewAsList#sideBarFavorites","group":"1_projectManager#sideBarFavorites"},{"command":"_projectManager.viewAsTags#sideBarFavorites","group":"1_projectManager#sideBarFavorites"},{"command":"_projectManager.sortBySaved#sideBarFavorites","group":"2_projectManager#sideBarFavorites"},{"command":"_projectManager.sortByName#sideBarFavorites","group":"2_projectManager#sideBarFavorites"},{"command":"_projectManager.sortByPath#sideBarFavorites","group":"2_projectManager#sideBarFavorites"},{"command":"_projectManager.sortByRecent#sideBarFavorites","group":"2_projectManager#sideBarFavorites"}]},"submenus":[{"id":"projectManager.sideBar.favorites.title","label":"View & Sort"}],"configuration":[{"id":"projectManager-general","title":"Project Manager","properties":{"projectManager.showProjectNameInStatusBar":{"type":"boolean","default":true,"description":"Should display the project name in the Status Bar?"},"projectManager.openInNewWindowWhenClickingInStatusBar":{"type":"boolean","default":false,"description":"Should the project be opened using a New Window when you click the Status Bar?"},"projectManager.removeCurrentProjectFromList":{"type":"boolean","default":true,"description":"Should the current project be hidden in the list of available projects?"},"projectManager.sortList":{"type":"string","default":"Name","description":"List the projects sorted by...(Saved, Name, Path or Recent)","enum":["Saved","Name","Path","Recent"],"scope":"application"},"projectManager.groupList":{"type":"boolean","default":false,"description":"List the projects grouped by...(Favorites, VSCode, Git, Mercurial and SVN)"},"projectManager.projectsLocation":{"type":"string","default":"","description":"Indicates an alternative location (folder path) where the `projects.json` file is stored"},"projectManager.cacheProjectsBetweenSessions":{"type":"boolean","default":true,"description":"Should cache the VSCode, Git and SVN projects found?"},"projectManager.ignoreProjectsWithinProjects":{"type":"boolean","default":false,"description":"Should ignore projects found inside other projects?"},"projectManager.checkInvalidPathsBeforeListing":{"type":"boolean","default":true,"description":"Should check for invalid paths before listing, showing a message below the project name?"},"projectManager.supportSymlinksOnBaseFolders":{"type":"boolean","default":false,"description":"Should support symlinks on `baseFolders`?"},"projectManager.showParentFolderInfoOnDuplicates":{"type":"boolean","default":false,"description":"Should show the parent folder info when projects with same name are detected?"},"projectManager.filterOnFullPath":{"type":"boolean","default":false,"description":"Should filter projects through full path?"},"projectManager.openInCurrenWindowIfEmpty":{"type":"string","default":"always","enum":["always","onlyUsingCommandPalette","onlyUsingSideBar","never"],"enumDescriptions":["Whenever you call the Open in New Window command, it will open in the current window, if empty","Only open in the current window if you use the Command Palette","Only open in the current window if you use the Side Bar","Works as today. The Open in New Window command will always open in New Window"],"description":"Indicates if the New Window command open the project in current window, when empty.","deprecationMessage":"Use `projectManager.openInCurrentWindowIfEmpty` instead"},"projectManager.openInCurrentWindowIfEmpty":{"type":"string","default":"always","enum":["always","onlyUsingCommandPalette","onlyUsingSideBar","never"],"enumDescriptions":["Whenever you call the Open in New Window command, it will open in the current window, if empty","Only open in the current window if you use the Command Palette","Only open in the current window if you use the Side Bar","Works as today. The Open in New Window command will always open in New Window"],"description":"Indicates if the New Window command open the project in current window, when empty."},"projectManager.confirmSwitchOnActiveWindow":{"type":"string","default":"never","enum":["never","onlyUsingCommandPalette","onlyUsingSideBar","always"],"enumDescriptions":["Works as today. No confirmation is required","Only ask for confirmation if you use the Command Palette","Only ask for confirmation if you use the Side Bar","Whenever you call the Open command, it will ask for confirmation"],"description":"Controls whether the extension should ask for confirmation when opening projects in the active window."},"projectManager.tags":{"type":"array","default":["Personal","Work"],"items":{"type":"string"},"description":"Indicates the list of tags you can use to organize your projects"},"projectManager.tags.collapseItems":{"type":"string","default":"startExpanded","enum":["alwaysExpanded","alwaysCollapsed","startExpanded","startCollapsed"],"enumDescriptions":["Tag groups are always expanded.","Tag groups are always collapsed.","Tag groups start expanded, but remember your last expand/collapse state.","Tag groups start collapsed, but remember your last expand/collapse state."],"description":"Controls how tag groups in the Favorites view are expanded or collapsed by default, and whether their state is remembered."}}},{"id":"projectManager-git","title":"Git","properties":{"projectManager.git.baseFolders":{"type":"array","default":[],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to search for Git projects"},"projectManager.git.ignoredFolders":{"type":"array","default":["node_modules","out","typings","test",".haxelib"],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to be ignored when searching for projects"},"projectManager.git.maxDepthRecursion":{"type":"integer","default":4,"description":"Indicates the maximum depth of folder recursion to search for projects. Any value below 1 means there is no limit"}}},{"id":"projectManager-hg","title":"Mercurial","properties":{"projectManager.hg.baseFolders":{"type":"array","default":[],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to search for Mercurial projects"},"projectManager.hg.ignoredFolders":{"type":"array","default":["node_modules","out","typings","test",".haxelib"],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to be ignored when searching for projects"},"projectManager.hg.maxDepthRecursion":{"type":"integer","default":4,"description":"Indicates the maximum depth of folder recursion to search for projects. Any value below 1 means there is no limit"}}},{"id":"projectManager-svn","title":"SVN","properties":{"projectManager.svn.baseFolders":{"type":"array","default":[],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to search for SVN projects"},"projectManager.svn.ignoredFolders":{"type":"array","default":["node_modules","out","typings","test"],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to be ignored when searching for projects"},"projectManager.svn.maxDepthRecursion":{"type":"integer","default":4,"description":"Indicates the maximum depth of folder recursion to search for projects. Any value below 1 means there is no limit"}}},{"id":"projectManager-vscode","title":"VS Code","properties":{"projectManager.vscode.baseFolders":{"type":"array","default":[],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to search for VSCode projects"},"projectManager.vscode.ignoredFolders":{"type":"array","default":["node_modules","out","typings","test"],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to be ignored when searching for projects"},"projectManager.vscode.maxDepthRecursion":{"type":"integer","default":4,"description":"Indicates the maximum depth of folder recursion to search for projects. Any value below 1 means there is no limit"}}},{"id":"projectManager-any","title":"Any","properties":{"projectManager.any.baseFolders":{"type":"array","default":[],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to search for any folder projects"},"projectManager.any.ignoredFolders":{"type":"array","default":["node_modules","out","typings","test"],"items":{"type":"string"},"markdownDescription":"Indicates folders or [glob patterns](https://code.visualstudio.com/docs/editor/glob-patterns) to be ignored when searching for projects"},"projectManager.any.excludeBaseFoldersFromResults":{"type":"boolean","default":false,"description":"Exclude the base folders themselves from the auto-detected projects list"},"projectManager.any.maxDepthRecursion":{"type":"integer","default":4,"description":"Indicates the maximum depth of folder recursion to search for projects. Any value below 1 means there is no limit"}}}],"colors":[{"id":"projectManager.sideBar.currentProjectHighlightForeground","description":"The color to highlight the current project in the Side Bar","defaults":{"light":"#2fb15b","dark":"#2fb15b","highContrast":"#2fb15b"}}],"keybindings":[{"command":"projectManager.listProjects","key":"shift+alt+p","mac":"cmd+alt+p"}],"walkthroughs":[{"id":"projectManagerWelcome","title":"Get Started with Project Manager","description":"Learn more about Project Manager to optimize your workflow","steps":[{"id":"saveYourFavoriteProjects","title":"Save Your Favorite Projects","description":"Easily acces your favorite projects, no matter where they are located.\n__Don't miss those important projects anymore__\n[Save Project](command:projectManager.saveProject)","media":{"markdown":"walkthrough/saveYourFavoriteProjects.md"}},{"id":"autoDetectGitRepositories","title":"Auto-detect Git Repositories","description":"Define a set of base folders where your Git projects are located and the extension present you.\n[Open Settings](command:workbench.action.openSettings?%5B%22projectManager.git.baseFolders%22%5D)","media":{"markdown":"walkthrough/autoDetectGitRepositories.md"}},{"id":"findAndOpenProjects","title":"Find and Open Your Projects","description":"Quickly access all your projects in the **Command Palette** and it its exclusive **Side Bar**.\n[List Projects to Open](command:projectManager.listProjects)","media":{"markdown":"walkthrough/findAndOpenProjects.md"}},{"id":"organizeWithTags","title":"Organize with Tags","description":"You can organize/categorize your projects using **Tags**. Filter your projects by **Tags** and even choose active **Tags** that are more relevant to the work you are doing.","media":{"markdown":"walkthrough/organizeWithTags.md"}},{"id":"exclusiveSideBar","title":"Exclusive Side Bar","description":"An exclusive Side Bar with everything you need for great productivity.\n[Open Side Bar](command:_projectManager.openSideBar)","media":{"markdown":"walkthrough/exclusiveSideBar.md"}},{"id":"workingWithRemotes","title":"Working with Remotes","description":"The extension support [Remote Development](https://code.visualstudio.com/docs/remote/remote-overview) scenarios, and you may choose how to use it, depending on your needs.","media":{"markdown":"walkthrough/workingWithRemotes.md"}}]}]},"eslintConfig":{"extends":["vscode-ext"],"rules":{"indent":["error",4,{"SwitchCase":1}],"no-tabs":"error","semi":["error","always"],"no-unexpected-multiline":"error"}},"scripts":{"build":"webpack --mode development","watch":"webpack --watch --mode development","vscode:prepublish":"webpack --mode production","webpack":"webpack --mode development","webpack-dev":"webpack --mode development --watch","compile":"tsc -p ./","lint":"eslint -c package.json --ext .ts src vscode-whats-new","pretest":"npm run compile && npm run lint","test-compile":"tsc -p ./ && npm run webpack","just-test":"node ./out/src/test/runTest.js","test":"npm run test-compile && npm run just-test"},"devDependencies":{"@types/mocha":"^10.0.0","@types/node":"^22.18.10","@types/vscode":"^1.78.0","@typescript-eslint/eslint-plugin":"^6.21.0","@typescript-eslint/parser":"^6.21.0","@vscode/test-electron":"^2.5.2","eslint":"^8.1.0","eslint-config-vscode-ext":"^1.1.0","mocha":"^11.1.0","terser-webpack-plugin":"^5.2.4","ts-loader":"^9.2.5","typescript":"^5.3.3","webpack":"^5.105.0","webpack-cli":"^4.8.0"},"dependencies":{"glob":"^10.5.0","minimatch":"^10.2.4","vscode-ext-codicons":"^1.4.0","vscode-ext-help-and-feedback-view":"^1.0.1","walker":"^1.0.7"}},"location":{"$mid":1,"path":"/home/dev/.antigravity/extensions/alefragnani.project-manager-13.1.1-universal","scheme":"file"},"isBuiltin":false,"targetPlatform":"universal","publisherDisplayName":"alefragnani","metadata":{"installedTimestamp":1778762591227,"source":"gallery","id":"1b747f06-3789-4ebd-ac99-f1fe430c3347","publisherId":"3fbdef65-bdf5-4723-aeaf-9e12a50546ef","publisherDisplayName":"alefragnani","targetPlatform":"universal","updated":false,"private":false,"isPreReleaseVersion":false,"hasPreReleaseVersion":false,"size":2955821},"isValid":true,"validations":[],"preRelease":false},{"type":1,"identifier":{"id":"arthurlobo.easy-codesnap","uuid":"74ee6421-4ae5-4bdc-b642-afa6fd1a2522"},"manifest":{"name":"easy-codesnap","displayName":"Easy CodeSnap","description":"Extension to take beautiful custom screenshots of your code 📷","version":"1.37.4","l10n":"./l10n","repository":{"type":"git","url":"https://github.com/ArthurLobopro/easy-codesnap"},"sponsor":{"url":"https://buymeacoffee.com/arthurlobo"},"license":"MIT","icon":"icon.png","engines":{"vscode":"^1.99.0"},"publisher":"ArthurLobo","categories":["Other"],"activationEvents":["onStartupFinished"],"main":"./dist/extension.js","contributes":{"commands":[{"command":"easy-codesnap.snap","title":"Open Easy CodeSnap"},{"command":"easy-codesnap.openSettings","title":"Easy CodeSnap: Open Settings"},{"command":"easy-codesnap.importSettings","title":"Easy CodeSnap: Import CodeSnap Settings"}],"menus":{"editor/context":[{"command":"easy-codesnap.snap","when":"editorHasSelection && !editorHasMultipleSelections"}]},"configuration":{"type":"object","title":"Easy CodeSnap","properties":{"easy-codesnap.lockOnOpen":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Locks the snap screen on open. Locked screens do not respond to selection changes.","order":1},"easy-codesnap.linkOnOpen":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Links the snap screen to the editor on open. Linked screens respond only to selection changes within the active editor.","order":2},"easy-codesnap.performShutterActionOnOpen":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Automatically performs the configured shutter action when the snap screen opens.","order":3},"easy-codesnap.shutterAction":{"scope":"resource","type":"string","enum":["copy","save"],"default":"copy","markdownDescription":"Controls the behavior of the shutter button when taking a snapshot.","markdownEnumDescriptions":["Copies the snapshot to the clipboard.","Stores the snapshot to a file."],"order":4},"easy-codesnap.shutterActionAnimation":{"scope":"resource","type":"string","enum":["flash","shutter","colored-shutter"],"default":"flash","markdownDescription":"Controls the animation effect used when the shutter button is clicked.","markdownEnumDescriptions":["Applies a quick flash effect to indicate that a snapshot has been taken.","Applies a shutter closing and opening animation effect to indicate that a snapshot has been taken.","Applies a colored shutter closing and opening animation effect to indicate that a snapshot has been taken. The color matches the extension shutter icon."],"order":5},"easy-codesnap.saveFormat":{"scope":"resource","type":"string","enum":["png","svg","webp"],"default":"png","markdownDescription":"Specifies the file format for saving snapshots.","markdownEnumDescriptions":["Stores the snapshot in PNG format as a lossless bitmap image that supports transparency.","Stores the snapshot in SVG format as a vector image that can be scaled without quality loss.","Stores the snapshot in WEBP format as a bitmap image that provides efficient compression for smaller file sizes."],"order":6},"easy-codesnap.saveScale":{"scope":"resource","type":"number","enum":[0.5,0.75,1,1.5,2,3,4],"default":1,"markdownDescription":"Controls the scale to use when saving snapshots in PNG format.","markdownEnumDescriptions":["Scales the snapshot to 50% of the original size.","Scales the snapshot to 75% of the original size.","Keeps the snapshot at its original size (100%).","Scales the snapshot to 150% of the original size.","Scales the snapshot to 200% of the original size.","Scales the snapshot to 300% of the original size.","Scales the snapshot to 400% of the original size."],"order":7},"easy-codesnap.optimizeSvg":{"scope":"resource","type":"boolean","default":true,"markdownDescription":"Controls whether the svg should be optimized before saving. Only valid when [Easy-codesnap: Save Format](command:workbench.action.openSettings?%22@id:easy-codesnap.saveFormat%22) is set to `svg`.","order":8},"easy-codesnap.useFallbackPngExporter":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Controls whether the fallback PNG exporter is used as the primary exporter when saving snapshots in PNG format. Useful when the default exporter produces unexpected results.","order":9},"easy-codesnap.showLineNumbers":{"scope":"resource","type":"boolean","default":true,"markdownDescription":"Displays line numbers in the snap screen.","order":10},"easy-codesnap.realLineNumbers":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Displays actual line numbers from the selection instead of starting at 1. Only valid when [Easy-codesnap: Show Line Numbers](command:workbench.action.openSettings?%22@id:easy-codesnap.showLineNumbers%22) is enabled.","order":11},"easy-codesnap.highlightLineNumber":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Highlights the active line number using the `editorLineNumber-activeForeground` theme color. Only valid when [Easy-codesnap: Show Line Numbers](command:workbench.action.openSettings?%22@id:easy-codesnap.showLineNumbers%22) is enabled.","order":12},"easy-codesnap.fullLinesSelection":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Extends the selection to entire lines when opening the snap screen.","order":13},"easy-codesnap.windowStyle":{"scope":"resource","type":"string","enum":["macos","windows"],"default":"macos","markdownDescription":"Controls the window style for the snap screen.","markdownEnumDescriptions":["Applies macOS style to the snap screen with traffic light buttons.","Applies Windows style to the snap screen with standard window decorations."],"order":14},"easy-codesnap.windowIconType":{"scope":"resource","type":"string","enum":["round","square"],"default":"round","markdownDescription":"Controls the window icon style. Only valid when [Easy-codesnap: Window Style](command:workbench.action.openSettings?%22@id:easy-codesnap.windowStyle%22) is set to `windows`.","markdownEnumDescriptions":["Displays round icons in the window.","Displays square icons in the window."],"order":15},"easy-codesnap.showWindowTitle":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Displays the snap screen window title.","order":16},"easy-codesnap.windowTitleTemplate":{"scope":"resource","type":"string","minLength":1,"default":"{workspace} - {fileName}","markdownDescription":"Defines a template for the snap screen window title. Supports {workspace}, {fileName}, and {relativeFolder} variables.","order":17},"easy-codesnap.showWindowControls":{"scope":"resource","type":"boolean","default":true,"markdownDescription":"Displays window controls styled according to the selected operating system.","order":18},"easy-codesnap.roundedCorners":{"scope":"resource","type":"boolean","default":true,"markdownDescription":"Controls whether the snap screen window has rounded corners.","order":19},"easy-codesnap.roundingLevel":{"scope":"resource","type":"number","enum":[1,2,3,4],"default":1,"markdownDescription":"Controls the border radius level of the snap container. Only valid when [Easy-codesnap: Rounded Corners](command:workbench.action.openSettings?%22@id:easy-codesnap.roundedCorners%22) is enabled.","markdownEnumDescriptions":["Applies small rounded corners to the snap container.","Applies medium rounded corners to the snap container.","Applies large rounded corners to the snap container.","Applies extra large rounded corners to the snap container."],"order":20},"easy-codesnap.target":{"scope":"resource","type":"string","enum":["container","window"],"default":"container","markdownDescription":"Specifies the capture target when taking a snapshot.","markdownEnumDescriptions":["Captures the window along with the container that surrounds it as the snapshot target.","Captures only the window with the code snippet, title, and buttons as the snapshot target."],"order":21},"easy-codesnap.boxShadow":{"scope":"resource","type":"string","default":"rgba(0, 0, 0, 0.55) 0px 20px 68px","markdownDescription":"Defines the CSS `box-shadow` property for the snap container.","order":22},"easy-codesnap.backgroundColor":{"scope":"resource","type":"string","default":"#abb8c3","markdownDescription":"Defines the background color of the snap container.","order":23},"easy-codesnap.containerPadding":{"scope":"resource","type":"string","default":"3em","markdownDescription":"Defines the padding of the snap container.","order":24},"easy-codesnap.transparentBackground":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Uses a transparent background for the container when taking the snapshot. Only valid when [Easy-codesnap: Target](command:workbench.action.openSettings?%22@id:easy-codesnap.target%22) is set to `container`.","order":25},"easy-codesnap.enableResizing":{"scope":"resource","type":"boolean","default":true,"markdownDescription":"Allows resizing of the snap container. When disabled, this also resets any previous size adjustments.","order":26},"easy-codesnap.enableSymbolBreadcrumb":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Controls whether the symbol breadcrumb is displayed in the snap screen.","order":27},"easy-codesnap.maxCharWidth":{"scope":"resource","type":"integer","minimum":0,"maximum":200,"default":0,"markdownDescription":"Specifies the maximum line width in characters. Set to `0` for no limit. Invalid values are ignored, and the last valid value is retained.","order":28},"easy-codesnap.aspect-ratio":{"scope":"resource","type":"string","enum":["none","1:1","4:5","9:16","16:9","1.91:1"],"default":"none","markdownDescription":"Controls the aspect ratio of the snapshot. Only valid when [Easy-codesnap: Target](command:workbench.action.openSettings?%22@id:easy-codesnap.target%22) is set to `container`.","markdownEnumDescriptions":["Applies no fixed aspect ratio to the snapshot.","Applies a 1:1 ratio to the snapshot (square format).","Applies a 4:5 ratio to the snapshot (portrait format).","Applies a 9:16 ratio to the snapshot (vertical format).","Applies a 16:9 ratio to the snapshot (widescreen format).","Applies a 1.91:1 ratio to the snapshot (landscape format)."],"order":29},"easy-codesnap.watermark":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Displays a watermark on the snapshot.","order":30},"easy-codesnap.defaultWatermarkText":{"scope":"resource","type":"string","default":"Made with Easy CodeSnap","markdownDescription":"Defines the default watermark text.","order":31},"easy-codesnap.watermarkPosition":{"scope":"resource","type":"string","enum":["top-left","top-right","bottom-left","bottom-right"],"default":"bottom-right","markdownDescription":"Controls the position of the watermark. Top positions are only available when [Easy-codesnap: Target](command:workbench.action.openSettings?%22@id:easy-codesnap.target%22) is set to `container`.","markdownEnumDescriptions":["Places the watermark at the top-left corner of the snapshot.","Places the watermark at the top-right corner of the snapshot.","Places the watermark at the bottom-left corner of the snapshot.","Places the watermark at the bottom-right corner of the snapshot."],"order":32},"easy-codesnap.keepOriginalIndentation":{"scope":"resource","type":"boolean","default":false,"markdownDescription":"Preserves the original indentation of the selected code when taking a snapshot. When disabled, leading spaces or tabs may be trimmed based on the selection.","order":33},"easy-codesnap.uiCustomColors":{"scope":"resource","type":"object","default":{"watermarkPositionInputSelectedBackgroud":"var(--vscode-focusBorder)"},"markdownDescription":"Controls whether custom UI color overrides are applied to the extension's settings panel.","properties":{"watermarkPositionInputSelectedBackgroud":{"type":"string","default":"var(--vscode-focusBorder)","description":"Defines the background color used for the selected Watermark Position input, improving visibility in themes with low contrast."}},"order":34}}}},"keywords":["CodeSnap","Screenshot","Screenshot Tool","Screenshot Extension","Code Snapshot","Polacode","Code Screenshot","snippet","share","carbon"],"scripts":{"vscode:prepublish":"npm run package","webpack":"webpack --mode development","webpack-dev":"webpack --mode development --watch","package":"yarn build:css && webpack --mode production","compile":"yarn run webpack","watch":"yarn webpack-dev","lint":"biome check","lint:fix":"biome check --write","translation-status":"tsx cli translation-status","compress-json":"tsx cli compress-json","make-badges":"tsx cli make-badges","sort":"tsx cli sort order && tsx cli sort nls","build:css":"tailwindcss -i ./webview/style.css -o ./webview/output.css -m"},"devDependencies":{"@biomejs/biome":"^2.3.6","@svgr/webpack":"^8.1.0","@types/node":"18.x","@types/react":"^19.1.8","@types/react-dom":"^19.1.6","@types/vscode":"^1.99.0","badge-maker":"^4.1.0","commander":"^14.0.1","esbuild-loader":"^4.4.0","sharp":"^0.34.4","tailwindcss":"^3","tsx":"^4.20.6","typescript":"^6.0.3","webpack":"^5.102.1","webpack-cli":"^6.0.1"},"dependencies":{"@arthur-lobo/object-pick":"^1.