{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schema/2025-02-28/mcp-config.schema.json",
  "mcpServers": {
    "shared-memory": {
      "command": "node",
      "args": [
        "/home/dev/AI_Workflow/mcp/shared-memory-server/index.js"
      ],
      "env": {
        "MEMORY_DIR": "/home/dev/AI_Workflow/memory",
        "KNOWLEDGE_DIR": "/home/dev/AI_Workflow/knowledge",
        "REPO_ROOT": "/home/dev/AI_Workflow"
      }
    },
    "scaffold": {
      "command": "node",
      "args": [
        "/home/dev/AI_Workflow/mcp/scaffold-server/index.js"
      ],
      "env": {
        "TEMPLATES_DIR": "/home/dev/AI_Workflow/knowledge/templates"
      }
    },
    "gitkraken": {
      "command": "gk",
      "args": [
        "mcp",
        "--readonly"
      ],
      "env": {
        "NO_TELEMETRY": "1"
      },
      "disabled": false
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-d67b84ab-9990-4b5b-b701-4734c64bfa75"
      }
    },
    "hostinger-domains": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-domains-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "cD9NlSvKkO7GhBrOmag56lhZ1x72yDd8LTElx7fz5742c829"
      },
      "enabled": true
    },
    "hostinger-dns": {
      "command": "npx",
      "args": [
        "--package=hostinger-api-mcp@latest",
        "hostinger-dns-mcp"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": "cD9NlSvKkO7GhBrOmag56lhZ1x72yDd8LTElx7fz5742c829"
      },
      "enabled": true
    },
    "agent-browser": {
      "command": "/home/dev/.local/bin/agent-browser",
      "args": [
        "mcp",
        "--tools",
        "core"
      ],
      "enabled": true
    }
  }
}
