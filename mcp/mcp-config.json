{
  "$schema": "https://raw.githubusercontent.com/modelcontextprotocol/specification/main/schema/2025-02-28/mcp-config.schema.json",
  "mcpServers": {
    "shared-memory": {
      "command": "node",
      "args": [
        "/home/dev/AI_Workflow/mcp/shared-memory-server/index.js"
      ],
      "env": {
        "MEMORY_DIR": "/home/dev/AI_Workflow/memory",
        "KNOWLEDGE_DIR": "/home/dev/AI_Workflow/knowledge",
        "REPO_ROOT": "/home/dev/AI_Workflow"
      }
    },
    "scaffold": {
      "command": "node",
      "args": [
        "/home/dev/AI_Workflow/mcp/scaffold-server/index.js"
      ],
      "env": {
        "TEMPLATES_DIR": "/home/dev/AI_Workflow/knowledge/templates"
      }
    },
    "gitkraken": {
      "command": "gk",
      "args": [
        "mcp",
        "--readonly"
      ],
      "env": {
        "NO_TELEMETRY": "1"
      },
      "disabled": false
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "ctx7sk-d67b84ab-9990-4b5b-b701-4734c64bfa75"
      }
    },
    "hostinger": {
      "command": "node",
      "args": [
        "/home/dev/AI_Workflow/mcp/hostinger/node_modules/hostinger-api-mcp/src/servers/all.js"
      ],
      "env": {
        "HOSTINGER_API_TOKEN": ""
      },
      "enabled": true
    }
  }
}
