#!/usr/bin/env bash
# h-commit — Git add + commit with Agent[<name>]: format
# Usage: h-commit <message>

source "$(dirname "$0")/lib/h-common.sh"

MESSAGE="${*:-}"

if [[ -z "$MESSAGE" ]]; then
  die "Usage: h-commit <commit message>"
fi

ANAME="$(agent_name)"
COMMIT_SCRIPT="$PAOS_HOME/bin/agent-commit.sh"

if [[ ! -x "$COMMIT_SCRIPT" ]]; then
  die "agent-commit.sh not found at $COMMIT_SCRIPT"
fi

exec "$COMMIT_SCRIPT" "$ANAME" "Agent[$ANAME]: $MESSAGE"
