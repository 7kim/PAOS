{
  "$schema": "./registry.schema.json",
  "version": "1.0.0",
  "mcpServers": {
    "shared-memory": {
      "command": "node",
      "args": ["/home/dev/AI_Workflow/mcp/shared-memory-server/index.js"],
      "env": {
        "MEMORY_DIR": "/home/dev/AI_Workflow/memory",
        "KNOWLEDGE_DIR": "/home/dev/AI_Workflow/knowledge",
        "REPO_ROOT": "/home/dev/AI_Workflow"
      }
    },
    "scaffold": {
      "command": "node",
      "args": ["/home/dev/AI_Workflow/mcp/scaffold-server/index.js"],
      "env": {
        "TEMPLATES_DIR": "/home/dev/AI_Workflow/knowledge/templates"
      }
    },
    "gitkraken": {
      "command": "gk",
      "args": ["mcp", "--readonly"],
      "env": { "NO_TELEMETRY": "1" }
    }
  },
  "agents": [
    {
      "id": "claude",
      "label": "Claude Code",
      "role": "Primary orchestrator and coding assistant",
      "binary": "claude",
      "color": "#f97316",
      "configPaths": ["~/.claude/CLAUDE.md", "~/.claude/mcp.json", "~/.claude/settings.json"],
      "mcpServers": ["shared-memory", "scaffold", "gitkraken"],
      "inbox": "memory/inbox/claude",
      "log": "logs/claude/events.md",
      "gitIdentity": {
        "name": "Claude Code [PAOS]",
        "email": "claude@paos.nodealgo.com"
      },
      "permissions": {
        "read": ["knowledge", "memory", "logs", "projects"],
        "write": ["memory", "logs", "project-files"],
        "execute": ["bash", "mcp"]
      },
      "healthChecks": ["binary", "config", "mcp", "identity", "inbox", "log"],
      "riskLevel": "high"
    },
