    {
      "dot": "rose",
      "title": "Coordination",
      "items": [
        "Coordinator delegates tasks to Claude, Gemini, Codex via '@shorthand' mentions",
        "Antigravity review loop enforces Plan \u2192 Review \u2192 Execute flow",
        "Developer (opencode) is auto-executed via systemd/Tailscale",
        "Hermes routes messages to agents via MCP send_message"
      ]
    },
    {
      "dot": "cyan",
      "title": "Messaging Hub",
      "items": [
        "send_message writes to memory/inbox/<recipient>/",
        "Inbox is the shared message store",
        "Recipients read their inbox via read_inbox MCP tool",
        "Cross-agent messages use @shorthand mentions"
      ]
    },
    {
      "dot": "emerald",
      "title": "Shared Memory",
      "items": [
        "global_ledger.md \u2014 append-only audit log",
        "shared/context.md \u2014 thinking context",
        "write_context appends to shared/context.md",
        "append_ledger writes to global_ledger.md",
        "events.md \u2014 per-agent event stream"
      ]
    }
